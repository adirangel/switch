<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ScreenSwitch</RootNamespace>
    <AssemblyName>ScreenSwitch</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>ScreenSwitch</Product>
    <Description>Tray app that switches monitor inputs between two computers over DDC/CI.</Description>
    <!-- Allows building and running the unit tests on a non-Windows host (CI/dev container). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Every shipped translation. Narrowing this list silently drops those satellite assemblies
         from the published output, leaving the interface English-only. -->
    <SatelliteResourceLanguages>en;es;fr;pt;he;ar;ja;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon still loads from a single-file, self-extracting publish. -->
    <EmbeddedResource Include="Resources\app.ico" LogicalName="ScreenSwitch.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenSwitch.Core\ScreenSwitch.Core.csproj" />
  </ItemGroup>

</Project>
